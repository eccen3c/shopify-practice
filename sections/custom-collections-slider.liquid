{{ 'custom-collections-slider.css' | asset_url | stylesheet_tag }}

<section class="collections-slider">
  <div class="collections-slider__track">
    {%- for block in section.blocks -%}
      <a
        href="{{ block.settings.link | default: '#' }}"
        class="collections-slider__item"
        {{ block.shopify_attributes }}
      >
        <div class="collections-slider__image-wrap">
          {%- if block.settings.image -%}
            <img
              class="collections-slider__image"
              src="{{ block.settings.image | image_url: width: 600 }}"
              alt="{{ block.settings.label | escape }}"
              width="416"
              height="515"
              loading="lazy"
            >
          {%- endif -%}
        </div>

        {%- if block.settings.label != blank -%}
          <span class="collections-slider__label">{{ block.settings.label }}</span>
        {%- endif -%}
      </a>
    {%- endfor -%}
  </div>
</section>

<script>
  (function () {
    const track = document.querySelector('.collections-slider__track');
    if (!track) return;

    let isDown = false;
    let startX, scrollLeft;

    track.addEventListener('mousedown', e => {
      isDown = true;
      track.style.cursor = 'grabbing';
      startX = e.pageX - track.offsetLeft;
      scrollLeft = track.scrollLeft;
    });

    track.addEventListener('mouseleave', () => {
      isDown = false;
      track.style.cursor = 'grab';
    });

    track.addEventListener('mouseup', () => {
      isDown = false;
      track.style.cursor = 'grab';
    });

    track.addEventListener('mousemove', e => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - track.offsetLeft;
      track.scrollLeft = scrollLeft - (x - startX);
    });
  })();
</script>

{% schema %}
{
  "name": "Collections Slider",
  "tag": "section",
  "blocks": [
    {
      "type": "item",
      "name": "Collection item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collections Slider",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}
